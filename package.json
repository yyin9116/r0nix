{
  "name": "pdf-reader-tauri",
  "version": "0.0.6",
  "description": "PDF Reader with Swiss Design - Tauri + React",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:pdf-blocks": "node --experimental-strip-types scripts/test-pdf-blocks.mjs",
    "test:resource-cache": "node --experimental-strip-types scripts/test-resource-cache.mjs",
    "test:document-artifacts": "node --experimental-strip-types scripts/test-document-artifacts.mjs",
    "test:markdown-blocks": "node --experimental-strip-types scripts/test-markdown-blocks.mjs",
    "test:settings-security": "node --experimental-strip-types scripts/test-settings-security.mjs",
    "test:browser-history": "node --experimental-strip-types scripts/test-browser-history.mjs",
    "test:reader-annotations": "node --experimental-strip-types scripts/test-reader-annotations.mjs",
    "test:overlay-placement": "node --experimental-strip-types scripts/test-overlay-placement.mjs",
    "test:reading-companion": "node --experimental-strip-types scripts/test-reading-companion.mjs",
    "test:companion-suggestion": "node --experimental-strip-types scripts/test-companion-suggestion.mjs",
    "test:companion-dwell": "node --experimental-strip-types scripts/test-companion-dwell.mjs",
    "test:pdf-zoom-gesture": "node --experimental-strip-types scripts/test-pdf-zoom-gesture.mjs",
    "test:backend-guard": "node scripts/check-backend-constraints.mjs --self-test",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib -- --ignored",
    "test:pdf-link": "node scripts/smoke-e2e.mjs --pdf-link-only",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:runtime-hygiene": "node scripts/check-python-runtime-hygiene.mjs",
    "check:image-index": "node scripts/check-image-index-contract.mjs",
    "check:resource-cache": "node scripts/check-resource-cache-contract.mjs",
    "check:markdown": "node scripts/check-markdown-contract.mjs",
    "check:reading-assist": "node scripts/check-reading-assist-contract.mjs",
    "check:document-reference": "node scripts/check-document-reference-contract.mjs",
    "check:whiteboard": "node scripts/check-whiteboard-contract.mjs",
    "check:tab-lifecycle": "node scripts/check-tab-lifecycle-contract.mjs",
    "check:core-navigation": "node scripts/check-core-navigation-contract.mjs",
    "check:dialog-errors": "node scripts/check-dialog-error-contract.mjs",
    "check:translation-race": "node scripts/check-translation-race-contract.mjs",
    "check:pdf-open-cancellation": "node scripts/check-pdf-open-cancellation.mjs",
    "check:native-lifecycle": "node scripts/check-native-lifecycle-contract.mjs",
    "check:webview-pdf-open": "node scripts/check-webview-pdf-open-contract.mjs",
    "check:pdf-virtualization": "node scripts/check-pdf-virtualization.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:source-view": "node scripts/lib/source-view.mjs",
    "design:snapshot": "node scripts/design-diff/snapshot.mjs",
    "design:normalize": "node scripts/design-diff/normalize.mjs",
    "design:diff": "node scripts/design-diff/diff.mjs",
    "design:probe": "node scripts/design-diff/probe.mjs",
    "design:probe:all": "node scripts/design-diff/probe-all.mjs",
    "check:backend": "node scripts/check-backend-constraints.mjs",
    "check:contracts": "npm run check:source-view && npm run check:native-lifecycle && npm run check:webview-pdf-open && npm run check:pdf-virtualization && npm run check:image-index && npm run check:resource-cache && npm run check:markdown && npm run check:reading-assist && npm run check:document-reference && npm run check:whiteboard && npm run check:tab-lifecycle && npm run check:core-navigation && npm run check:dialog-errors && npm run check:translation-race && npm run check:pdf-open-cancellation && npm run check:design-tokens && npm run check:backend",
    "test:fixtures": "npm run test:pdf-blocks && npm run test:resource-cache && npm run test:document-artifacts && npm run test:markdown-blocks && npm run test:settings-security && npm run test:browser-history && npm run test:reader-annotations && npm run test:overlay-placement && npm run test:reading-companion && npm run test:companion-suggestion && npm run test:companion-dwell && npm run test:pdf-zoom-gesture && npm run test:backend-guard",
    "verify": "npm run build && npm run check:release && npm run check:runtime-hygiene && npm run check:contracts && npm run test:fixtures && npm run test:native && npm run test:e2e",
    "tauri": "tauri",
    "tauri:build:macos": "bash scripts/build-macos-bundle.sh",
    "tauri:build:macos:debug": "bash scripts/build-macos-bundle.sh --debug"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.12",
    "motion": "^12.35.2",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
