      "label": "反相前景 content-inverse",
      "class": "text-content-inverse",
      "expect": {
        "light": { "color": "rgb(255, 255, 255)" },
        "dark": { "color": "rgb(9, 9, 11)" }
      }
    },
    {
      "label": "反相底 content-primary",
      "class": "bg-content-primary",
      "expect": {
        "light": { "backgroundColor": "rgb(24, 24, 27)" },
        "dark": { "backgroundColor": "rgb(244, 244, 245)" }
      }
    },
    {
      "label": "强调色前景 accent-on",
      "class": "text-accent-on",
      "expect": {
        "light": { "color": "rgb(255, 255, 255)" },
        "dark": { "color": "rgb(24, 24, 27)" }
      }
    },
    {
      "label": "主按钮 hover content-primary-hover",
