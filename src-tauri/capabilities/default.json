{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for PDF reader main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:path:allow-resolve-directory",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-write-text-file",
    "fs:allow-home-read-recursive",
    "fs:allow-desktop-read-recursive",
    "fs:allow-document-read-recursive",
    "fs:allow-download-read-recursive",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "fs:allow-temp-read-recursive",
    "fs:allow-temp-write-recursive",
    "fs:scope-temp-recursive",
    "shell:default",
    "shell:allow-open",
    "updater:default"
  ]
}
